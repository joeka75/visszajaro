{
  "expo": {
    "name": "Visszajáró",
    "slug": "visszajaro",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "visszajaro",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "hu.visszajaro.app",
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFE8DC",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "hu.visszajaro.app"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#D9480F",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "A Visszajáró a helyzeted alapján ajánl közeli éttermeket.",
          "locationAlwaysAndWhenInUsePermission": "A Visszajáró a háttérben felismeri, ha vendéglátóhelyen jársz, és utána megkérdezi, milyen volt. A helyadatok a telefonodon maradnak.",
          "locationAlwaysPermission": "A Visszajáró a háttérben felismeri, ha vendéglátóhelyen jársz, és utána megkérdezi, milyen volt.",
          "motionUsagePermission": false,
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#D9480F"
        }
      ],
      "./plugins/with-cmake-version",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
